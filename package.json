{
  "name": "atalho",
  "version": "1.2.2",
  "description": "Componentes de interface em português: HTML, CSS e JavaScript prontos, nos padrões das grandes empresas.",
  "license": "MIT",
  "author": "Marcos Zorzetto",
  "homepage": "https://marcos-zorzetto.github.io/atalho/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcos-zorzetto/atalho.git"
  },
  "keywords": [
    "componentes",
    "ui",
    "css",
    "javascript",
    "portugues",
    "pt-br",
    "bootstrap",
    "design-system"
  ],
  "type": "module",
  "files": [
    "atalho/"
  ],
  "main": "atalho/atalho.js",
  "style": "atalho/atalho.css",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"scripts/*.test.mjs\" \"servicos/supabase/functions/*/*.test.ts\" \"vscode-atalho/test/*.test.js\"",
    "atualizar": "node scripts/atualizar-documentacao.mjs --links",
    "build": "node scripts/gerar-site.mjs",
    "extensao": "node scripts/gerar-extensao.mjs && cd vscode-atalho && npx --yes @vscode/vsce@3 package --no-dependencies",
    "imagens": "node scripts/gerar-imagens.mjs",
    "tipos": "node scripts/verificar-typescript.mjs",
    "site": "node scripts/gerar-site.mjs --local && npx --yes serve dist",
    "e2e": "node scripts/gerar-site.mjs --local && node testes/interacoes.mjs",
    "auditoria": "node scripts/gerar-site.mjs --local && node testes/auditoria.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@phosphor-icons/core": "^2.1.1",
    "axe-core": "4.13.0",
    "playwright-core": "1.63.0"
  }
}
