// Configuração do Worker do assistente. Publicar: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atalho-assistente",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // Até 6 perguntas por minuto por endereço IP
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": {
    // Sites que podem usar o assistente (separados por vírgula)
    "ORIGENS": "https://marcos-zorzetto.github.io,http://localhost:5181",
    // O catálogo é publicado junto com o site: o assistente aprende componentes novos sozinho
    "CATALOGO_URL": "https://marcos-zorzetto.github.io/atalho/site/catalogo-ia.json"
  }
}
